    <string name="info_title_transfer_code">What is a Transfer Code?</string>
    <string name="info_body_transfer_code">After you upload a file, SafeShare creates a unique transfer code.\n\nIt contains the encrypted file location and a one-time key. Only the recipient with the matching private key can decrypt the file.\n\nThe server never sees your key, and the file stays encrypted end-to-end.</string>
    <string name="info_title_contacts">What are Contacts?</string>
    <string name="info_body_contacts">Contacts are saved public keys of people you send files to regularly.\n\nA public key is used to encrypt a file so that only the owner of the matching private key can open it.\n\nAdd a contact by scanning their QR code or entering their key manually.\n\nYour contacts are stored only on your device.</string>

    <string name="discovery_send_scan_title">Scan a QR code</string>
    <string name="discovery_send_scan_desc">Scan the recipient\'s public key QR. This sets up encryption so only they can decrypt the file.</string>
    <string name="discovery_send_pick_title">Pick a file</string>
    <string name="discovery_send_pick_desc">Choose any file from your device to send securely.</string>
    <string name="discovery_send_upload_title">Start upload</string>
    <string name="discovery_send_upload_desc">After selecting a file and recipient, tap here to encrypt and upload.</string>
    <string name="discovery_contacts_add_title">Add a contact</string>
    <string name="discovery_contacts_add_desc">Save a friend\'s public key so you can send files to them without scanning a QR each time.</string>
    <string name="discovery_contacts_qr_title">Your QR code</string>
    <string name="discovery_contacts_qr_desc">Show this QR to someone so they can add you as a contact and send files to you.</string>

